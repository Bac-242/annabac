---
import Layout from '../layouts/Layout.astro';
import Fil from '../components/Fil.astro';
import Icone from '../components/Icone.astro';

const depot = 'https://github.com/Bac-242/annabac';

const lien =
  'font-medium text-[color:var(--color-brand)] underline-offset-2 hover:underline';
const titreSection =
  'text-lg font-medium tracking-tight text-[color:var(--color-brand)]';

// Ce qu'il est utile de préciser dans le message : évite un aller-retour.
const aPreciser = [
  { label: 'Année', exemple: '2019' },
  { label: 'Série', exemple: 'A, C ou D' },
  { label: 'Matière', exemple: 'Mathématiques, Physique-Chimie…' },
  { label: 'Session', exemple: 'Normale, Remplacement ou Spéciale' },
  { label: 'Sujet ou corrigé', exemple: "l'énoncé, ou sa correction" },
];

const etapes = [
  "Vous envoyez ce que vous avez, dans le format qui vous arrange.",
  "Nous vérifions l'exactitude et l'origine du document.",
  'Nous le réécrivons entièrement au format du site, pour qu\'il soit net, homogène et lisible même photocopié.',
  'Il est publié, gratuitement et pour tous.',
];
---

<Layout
  titre="Contribuer"
  description="Envoyer un sujet ou un corrigé du baccalauréat congolais par e-mail, pour enrichir la bibliothèque Bac 242."
>
  <Fil items={[{ href: '/', label: 'Accueil' }, { label: 'Contribuer' }]} />

  <header class="max-w-2xl">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Contribuer</h1>
    <p class="mt-4 text-lg leading-relaxed text-[color:var(--color-muted)]">
      Bac 242 grandit grâce aux documents que vous partagez. Il n'y a ni compte à
      créer ni formulaire à remplir : écrivez-nous, c'est tout.
    </p>
    <p class="mt-4 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      Vous ne savez pas ce qui serait utile ? La page
      <a href="/manques" class={lien}>Ce qui nous manque</a> liste précisément
      les épreuves encore absentes de la bibliothèque.
    </p>
  </header>

  <!-- Point de contact unique du site -->
  <section class="card mt-8 max-w-2xl px-6 py-6 sm:px-8 sm:py-7">
    <h2 class={titreSection}>Envoyez-nous votre document</h2>
    <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      Joignez le sujet ou le corrigé à un e-mail adressé à :
    </p>
    <p class="mt-3 text-lg font-medium break-all">
      <a data-mail class={lien}>écrivez-nous</a>
    </p>
    <noscript>
      <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-muted)]">
        contact.bac242 (chez) gmail (point) com
      </p>
    </noscript>
    <div class="mt-5 flex flex-wrap items-center gap-4">
      <a data-mail="href" class="btn btn-primary">
        <Icone nom="mail" taille={18} />
        <span class="ml-2">Écrire au projet</span>
      </a>
      <span class="text-sm text-[color:var(--color-muted)]">
        Ouvre votre application de messagerie. Rien n'est enregistré par le site.
      </span>
    </div>
  </section>

  <!-- Le format n'a pas d'importance -->
  <section class="mt-12 max-w-2xl">
    <h2 class={titreSection}>Le format n'a aucune importance</h2>
    <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      Une photo prise au téléphone suffit. Un scan, un PDF, un document Word, une
      page manuscrite : envoyez ce que vous avez, même imparfait, même de
      travers. La seule chose qui compte est que ce soit <strong>lisible</strong>.
    </p>
    <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      Chaque document reçu est ensuite <strong>entièrement réécrit</strong> au
      format du site. C'est ce travail qui garantit une bibliothèque homogène,
      nette à l'impression et lisible en photocopie — vous n'avez donc aucune
      mise en forme à faire.
    </p>
  </section>

  <!-- Ce qu'il faut préciser -->
  <section class="mt-12 max-w-2xl">
    <h2 class={titreSection}>À préciser dans votre message</h2>
    <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      Pour que le document soit classé au bon endroit, indiquez si possible :
    </p>
    <ul class="mt-4 grid gap-2.5">
      {aPreciser.map((c) => (
        <li class="card flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-5 py-3">
          <span class="font-medium">{c.label}</span>
          <span class="text-sm text-[color:var(--color-muted)]">{c.exemple}</span>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      Pour un <strong>corrigé</strong>, précisez aussi son <strong>auteur ou son
      origine</strong> : cette attribution est affichée sur la fiche du document.
      Si vous souhaitez être crédité, dites-nous sous quel nom ou pseudonyme —
      vous pouvez tout aussi bien rester anonyme. Les crédits sont visibles sur
      la page <a href="/contributeurs" class={lien}>Contributeurs</a>.
    </p>
  </section>

  <!-- Parcours du document -->
  <section class="mt-12 max-w-2xl">
    <h2 class={titreSection}>Que deviennent les documents ?</h2>
    <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      {etapes.map((e) => <li>{e}</li>)}
    </ol>
    <p class="mt-4 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      En nous envoyant un document, vous confirmez avoir le droit de le partager
      pour un usage pédagogique non commercial. Nos engagements — gratuité,
      attribution, retrait sur simple demande d'un ayant droit — sont détaillés
      sur la page <a href="/a-propos" class={lien}>À propos</a>.
    </p>
  </section>

  <!-- Enseignants et établissements -->
  <section class="mt-12 max-w-2xl">
    <h2 class={titreSection}>Enseignants et établissements</h2>
    <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      La difficulté principale du projet n'est ni technique ni financière : c'est
      de <strong>retrouver les sujets</strong>. Ils ne sont pratiquement pas
      disponibles en ligne, et les archives se perdent d'une année sur l'autre.
    </p>
    <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      Si vous êtes professeur, correcteur, censeur ou proviseur, vous détenez
      peut-être sans le savoir des documents introuvables ailleurs : sujets des
      sessions passées, corrigés de référence, archives d'établissement. Une
      seule épreuve retrouvée profite à toutes les promotions suivantes.
    </p>
  </section>

  <!-- Autres façons d'aider -->
  <section class="mt-12 max-w-2xl">
    <h2 class={titreSection}>Autres façons d'aider</h2>
    <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      La même adresse accueille toutes les remarques : une erreur repérée dans un
      corrigé, un document illisible, une suggestion, une question.
    </p>
    <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      Si vous êtes à l'aise avec Git, le site est open source : vous pouvez
      <a href={`${depot}/issues`} class={lien}>ouvrir une issue</a> ou proposer
      directement une modification sur le
      <a href={depot} class={lien}>dépôt GitHub</a>.
    </p>
  </section>
</Layout>
