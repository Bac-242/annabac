---
import Layout from '../layouts/Layout.astro';
import Fil from '../components/Fil.astro';
import Icone from '../components/Icone.astro';
import { manques, styleMatiere } from '../lib/data';

const depot = 'https://github.com/Bac-242/annabac';

const m = await manques();
const couverts = m.complets + m.sansCorrige;

// Sujets publiés dont le corrigé manque : la lacune la plus simple à combler.
const sansCorrige = m.cases
  .filter((c) => c.etat === 'sans-corrige')
  .sort((a, b) => b.annee - a.annee || a.matiere.localeCompare(b.matiere, 'fr'));

const etapes = [
  'Nous vérifions le document.',
  'Nous le réécrivons au format du site.',
  'Il est publié, gratuit pour tous.',
];

const lien =
  'font-medium text-[color:var(--color-brand)] underline-offset-2 hover:underline';
const titreSection =
  'text-lg font-medium tracking-tight text-[color:var(--color-brand)]';
---

<Layout
  titre="Contribuer"
  description="Ce qui manque à la bibliothèque Bac 242, et comment envoyer un sujet ou un corrigé du baccalauréat congolais."
>
  <Fil items={[{ href: '/', label: 'Accueil' }, { label: 'Contribuer' }]} />

  <header class="max-w-2xl">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Contribuer</h1>
    <p class="mt-4 text-lg leading-relaxed text-[color:var(--color-muted)]">
      Bac 242 s'enrichit des documents que vous nous envoyez. Un e-mail suffit.
    </p>
  </header>

  <!-- Ce qui manque -->
  <section class="mt-10 max-w-2xl">
    <h2 class={titreSection}>Ce qui manque</h2>
    <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      La bibliothèque couvre <strong>{couverts} épreuves sur {m.total}</strong>.
    </p>

    {m.matieresVides.length > 0 && (
      <>
        <p class="mt-6 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
          Ces matières n'ont encore aucun document.
        </p>
        <ul class="mt-3 flex flex-wrap gap-2.5">
          {m.matieresVides.map((mat) => (
            <li
              class:list={[
                'flex items-center gap-2 rounded-full px-3.5 py-1.5 text-[13px] font-medium',
                styleMatiere(mat).classe,
              ]}
            >
              <Icone nom={styleMatiere(mat).icon} taille={15} />
              {mat}
            </li>
          ))}
        </ul>
      </>
    )}

    {m.anneesVides.length > 0 && (
      <>
        <p class="mt-6 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
          Ces sessions manquent entièrement.
        </p>
        <ul class="mt-3 flex flex-wrap gap-2.5">
          {m.anneesVides.map((a) => (
            <li class="pastille-ambre rounded-full px-3.5 py-1.5 text-[13px] font-medium">
              {a}
            </li>
          ))}
        </ul>
      </>
    )}

    {sansCorrige.length > 0 && (
      <>
        <p class="mt-6 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
          {sansCorrige.length} sujets attendent leur corrigé.
        </p>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2">
          {sansCorrige.map((c) => (
            <li>
              <a
                href={`/sujets/${c.slug}`}
                class="card card-hover flex items-center justify-between gap-3 px-4 py-2.5 text-sm"
              >
                <span>{c.annee} · Série {c.serie} · {c.matiere}</span>
                <Icone nom="arrow-right" taille={16} />
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </section>

  <!-- Envoyer -->
  <section class="card mt-12 max-w-2xl px-6 py-6 sm:px-8 sm:py-7">
    <h2 class={titreSection}>Envoyer un document</h2>
    <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      Écrivez-nous à :
    </p>
    <p class="mt-2 text-lg font-medium break-all">
      <a data-mail class={lien}>écrivez-nous</a>
    </p>
    <noscript>
      <p class="mt-2 text-[15px] leading-relaxed text-[color:var(--color-muted)]">
        contact.bac242 (chez) gmail (point) com
      </p>
    </noscript>
    <div class="mt-5">
      <a data-mail="href" class="btn btn-primary">
        <Icone nom="mail" taille={18} />
        <span class="ml-2">Écrire au projet</span>
      </a>
    </div>
    <p class="mt-5 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      Envoyez ce que vous avez : photo, scan, PDF. Il suffit que ce soit lisible.
    </p>
    <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      Indiquez si possible l'année, la série, la matière et la session, et s'il
      s'agit du sujet ou du corrigé. Pour un corrigé, précisez son auteur.
    </p>
  </section>

  <!-- Ensuite -->
  <section class="mt-12 max-w-2xl">
    <h2 class={titreSection}>Ensuite</h2>
    <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      {etapes.map((e) => <li>{e}</li>)}
    </ol>
    <p class="mt-4 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      Vous n'avez aucune mise en forme à faire. Dites-nous sous quel nom vous
      créditer, ou restez anonyme. Vous devez avoir le droit de partager ce que
      vous envoyez, pour un usage pédagogique non commercial. Nos engagements
      figurent sur la page <a href="/a-propos" class={lien}>À propos</a>.
    </p>
  </section>

  <!-- Enseignants -->
  <section class="mt-12 max-w-2xl">
    <h2 class={titreSection}>Enseignants et établissements</h2>
    <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      Retrouver les sujets est la vraie difficulté du projet. Ils sont presque
      introuvables en ligne et les archives se perdent d'une année sur l'autre.
    </p>
    <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      Si vous enseignez, corrigez ou dirigez un établissement, vous détenez
      peut-être des documents qu'on ne trouve nulle part ailleurs. Une épreuve
      retrouvée sert toutes les promotions suivantes.
    </p>
  </section>

  <!-- Autres façons d'aider -->
  <section class="mt-12 max-w-2xl">
    <h2 class={titreSection}>Autres façons d'aider</h2>
    <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      La même adresse reçoit les erreurs repérées dans un corrigé et les
      suggestions. Le site est open source : vous pouvez
      <a href={`${depot}/issues`} class={lien}>ouvrir une issue</a> ou proposer
      une modification sur le <a href={depot} class={lien}>dépôt GitHub</a>.
    </p>
  </section>
</Layout>
