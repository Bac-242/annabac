---
import Layout from '../layouts/Layout.astro';
import Fil from '../components/Fil.astro';
import Icone from '../components/Icone.astro';
import { manques, styleMatiere, styleSerie, type EtatCase } from '../lib/data';

const m = await manques();

const couverts = m.complets + m.sansCorrige;
const pourcent = m.total ? Math.round((couverts / m.total) * 1000) / 10 : 0;
const documents = m.complets * 2 + m.sansCorrige;

// Années entièrement vides, les plus récentes d'abord : ce sont les plus
// demandées par les élèves, donc les plus utiles à réclamer.
const anneesRecentes = m.anneesVides.slice(0, 6);

// Épreuves publiées sans corrigé : la lacune la moins coûteuse à combler,
// puisque le sujet est déjà là.
const sansCorrige = m.cases
  .filter((c) => c.etat === 'sans-corrige')
  .sort((a, b) => b.annee - a.annee || a.matiere.localeCompare(b.matiere, 'fr'));

// Lignes de la grille : un couple série × matière par ligne.
const lignes: { serie: string; matiere: string; cases: typeof m.cases }[] = [];
for (const c of m.cases) {
  const derniere = lignes[lignes.length - 1];
  if (derniere && derniere.serie === c.serie && derniere.matiere === c.matiere) {
    derniere.cases.push(c);
  } else {
    lignes.push({ serie: c.serie, matiere: c.matiere, cases: [c] });
  }
}

// Chaque état porte un glyphe ET un libellé : jamais d'information transmise
// par la seule couleur (même principe que les documents LaTeX du projet).
const ETATS: Record<EtatCase, { glyphe: string; libelle: string; classe: string }> = {
  complet: { glyphe: '●', libelle: 'Sujet et corrigé', classe: 'bg-ok-soft text-ok' },
  'sans-corrige': { glyphe: '◐', libelle: 'Sujet seul', classe: 'bg-info-soft text-info' },
  absent: {
    glyphe: '·',
    libelle: 'Manquant',
    classe: 'bg-[color:var(--color-canvas)] text-[color:var(--color-muted)]',
  },
};

const titreSection = 'text-lg font-medium tracking-tight text-[color:var(--color-brand)]';
const lien = 'font-medium text-[color:var(--color-brand)] underline-offset-2 hover:underline';
---

<Layout
  titre="Ce qui nous manque"
  description="Les sujets et corrigés du baccalauréat congolais qui manquent encore à la bibliothèque Bac 242 : par matière, série et année."
>
  <Fil items={[{ href: '/', label: 'Accueil' }, { label: 'Ce qui nous manque' }]} />

  <header class="max-w-2xl">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Ce qui nous manque</h1>
    <p class="mt-4 text-lg leading-relaxed text-[color:var(--color-muted)]">
      Cette page dit exactement ce qu'il reste à trouver. Si vous détenez l'un de
      ces documents — un professeur, un ancien élève, un établissement — vous
      savez précisément quoi nous envoyer.
    </p>
  </header>

  <!-- Chiffres clés -->
  <section class="mt-8 grid max-w-3xl gap-3 sm:grid-cols-3">
    <div class="card px-5 py-4">
      <p class="text-2xl font-semibold tracking-tight">{documents}</p>
      <p class="mt-0.5 text-sm text-[color:var(--color-muted)]">documents publiés</p>
    </div>
    <div class="card px-5 py-4">
      <p class="text-2xl font-semibold tracking-tight">{pourcent}&nbsp;%</p>
      <p class="mt-0.5 text-sm text-[color:var(--color-muted)]">
        des épreuves couvertes ({couverts} sur {m.total})
      </p>
    </div>
    <div class="card px-5 py-4">
      <p class="text-2xl font-semibold tracking-tight">{m.absents}</p>
      <p class="mt-0.5 text-sm text-[color:var(--color-muted)]">épreuves à retrouver</p>
    </div>
  </section>

  <!-- Priorités -->
  {(m.matieresVides.length > 0 || anneesRecentes.length > 0) && (
    <section class="mt-12 max-w-3xl">
      <h2 class={titreSection}>Les plus urgents</h2>

      {m.matieresVides.length > 0 && (
        <>
          <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
            <strong>{m.matieresVides.length} matières</strong> n'ont encore
            aucun document, toutes séries et toutes années confondues. Un seul
            sujet suffit à ouvrir une matière.
          </p>
          <ul class="mt-4 flex flex-wrap gap-2.5">
            {m.matieresVides.map((mat) => (
              <li
                class:list={[
                  'flex items-center gap-2 rounded-full px-3.5 py-1.5 text-[13px] font-medium',
                  styleMatiere(mat).classe,
                ]}
              >
                <Icone nom={styleMatiere(mat).icon} taille={15} />
                {mat}
              </li>
            ))}
          </ul>
        </>
      )}

      {anneesRecentes.length > 0 && (
        <>
          <p class="mt-6 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
            Ces sessions manquent <strong>entièrement</strong> — ce sont
            pourtant les plus recherchées par les élèves qui révisent :
          </p>
          <ul class="mt-4 flex flex-wrap gap-2.5">
            {anneesRecentes.map((a) => (
              <li class="rounded-full bg-err-soft px-3.5 py-1.5 text-[13px] font-medium text-err">
                {a}
              </li>
            ))}
          </ul>
        </>
      )}
    </section>
  )}

  <!-- Grille détaillée -->
  <section class="mt-12">
    <h2 class={titreSection}>Le détail, épreuve par épreuve</h2>
    <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      Une ligne par série et matière, une colonne par année.
    </p>

    <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-[color:var(--color-muted)]">
      {(Object.keys(ETATS) as EtatCase[]).map((e) => (
        <li class="flex items-center gap-2">
          <span
            class:list={[
              'flex h-6 w-6 items-center justify-center rounded-md text-xs',
              ETATS[e].classe,
            ]}
            aria-hidden="true"
          >
            {ETATS[e].glyphe}
          </span>
          {ETATS[e].libelle}
        </li>
      ))}
    </ul>

    <div class="mt-5 overflow-x-auto rounded-2xl border border-[color:var(--color-line)]">
      <table class="w-full border-collapse text-sm">
        <caption class="sr-only">
          État de la bibliothèque : pour chaque série, matière et année, si le
          sujet et le corrigé sont disponibles.
        </caption>
        <thead>
          <tr class="bg-[color:var(--color-surface)]">
            <th
              scope="col"
              class="sticky left-0 z-10 bg-[color:var(--color-surface)] px-4 py-2.5 text-left font-medium"
            >
              Série · matière
            </th>
            {m.annees.map((a) => (
              <th scope="col" class="px-1.5 py-2.5 text-center text-xs font-medium text-[color:var(--color-muted)]">
                {String(a).slice(2)}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {lignes.map((l) => (
            <tr class="border-t border-[color:var(--color-line)]">
              <th
                scope="row"
                class="sticky left-0 z-10 whitespace-nowrap bg-[color:var(--color-canvas)] px-4 py-2 text-left font-normal"
              >
                <span class:list={['mr-2 rounded-full px-2 py-0.5 text-[11px] font-medium', styleSerie(l.serie).classe]}>
                  {l.serie}
                </span>
                {l.matiere}
              </th>
              {l.cases.map((c) => {
                const e = ETATS[c.etat];
                const etiquette = `${l.matiere} série ${l.serie} ${c.annee} — ${e.libelle}`;
                return (
                  <td class="px-1 py-1 text-center">
                    {c.slug ? (
                      <a
                        href={`/sujets/${c.slug}`}
                        title={etiquette}
                        class:list={['flex h-7 w-7 items-center justify-center rounded-md transition hover:ring-2 hover:ring-[color:var(--color-brand)]', e.classe]}
                      >
                        <span aria-hidden="true">{e.glyphe}</span>
                        <span class="sr-only">{etiquette}</span>
                      </a>
                    ) : (
                      <span
                        title={etiquette}
                        class:list={['flex h-7 w-7 items-center justify-center rounded-md', e.classe]}
                      >
                        <span aria-hidden="true">{e.glyphe}</span>
                        <span class="sr-only">{etiquette}</span>
                      </span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Sujets sans corrigé -->
  {sansCorrige.length > 0 && (
    <section class="mt-12 max-w-3xl">
      <h2 class={titreSection}>Sujets publiés, corrigé attendu</h2>
      <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
        {sansCorrige.length} épreuves ont leur sujet en ligne mais pas encore de
        corrigé. C'est la lacune la plus simple à combler : le sujet est déjà là,
        il ne manque que la correction.
      </p>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {sansCorrige.map((c) => (
          <li>
            <a
              href={`/sujets/${c.slug}`}
              class="card card-hover flex items-center justify-between gap-3 px-4 py-2.5 text-sm"
            >
              <span>
                {c.annee} — Série {c.serie} — {c.matiere}
              </span>
              <Icone nom="arrow-right" taille={16} />
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Appel -->
  <section class="mt-12 max-w-2xl">
    <h2 class={titreSection}>Vous avez l'un de ces documents ?</h2>
    <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink)]">
      Une photo lisible suffit — inutile qu'elle soit parfaite, nous nous
      chargeons de la mise en forme. Voir <a href="/contribuer" class={lien}>comment
      nous l'envoyer</a>.
    </p>
  </section>
</Layout>
